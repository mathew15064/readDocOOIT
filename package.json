    "p-limit": "^4.0.0",
    "pino": "^9.2.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "supertest": "^7.0.0",
    "vitest": "^2.0.0"
  }
