{
  "name": "doc-reader",
  "version": "0.1.0",
  "description": "Local document reader and bookmark manager",
  "main": "src/server.js",
  "scripts": {
    "shots": "node scripts/capture-screenshots.mjs",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
